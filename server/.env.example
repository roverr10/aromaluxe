# Copia este archivo como .env dentro de la carpeta server/

# Puerto de la API (Vite hace proxy de /api y /uploads hacia aquí)
PORT=3001

# Usuario administrador que se crea automáticamente la primera vez
ADMIN_EMAIL=aromaluxe.catalogo@gmail.com
ADMIN_PASSWORD=seccion2

# Google OAuth (opcional). Sin esto, la página usa el modo demostración.
# Obtén el Client ID en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Cambia a false para desactivar el acceso demo en producción
ALLOW_DEMO_AUTH=true

# Entorno
NODE_ENV=development
